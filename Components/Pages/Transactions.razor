@page "/transactions"
@using ConnectFour.Models
@using ConnectFour.Services.Interfaces
@inject ITransactionService TransactionService
@inject ICategoryService CategoryService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Transactions</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Transactions</h1>
            <a class="btn btn-primary" href="/addedittransaction">Add Transaction</a>
        </div>

        <div class="mb-3">
            <label class="form-label">Filter by category</label>
            <form method="get">
                <select class="form-select" name="categoryId" onchange="this.form.submit()">
                    <option value="0" @(SelectedCategoryId == 0 ? "selected" : "")>All categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id" @(SelectedCategoryId == category.Id ? "selected" : "")>@category.Name</option>
                    }
                </select>
            </form>
        </div>

        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in filteredTransactions)
                {
                    <tr>
                        <td>@transaction.Date.ToShortDateString()</td>
                        <td>@transaction.Description</td>
                        <td>@transaction.Category?.Name</td>
                        <td>@transaction.Type</td>
                        <td>@transaction.Amount.ToString("C")</td>
                        <td>
                            <a class="btn btn-sm btn-secondary me-2" href="/addedittransaction/@transaction.Id">Edit</a>
                            <a class="btn btn-sm btn-danger" href="/delete-transaction/@transaction.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to view transactions.</p>
    </NotAuthorized>
</AuthorizeView>

@code {

    private IReadOnlyCollection<Transaction> transactions = Array.Empty<Transaction>();
    private IEnumerable<Transaction> filteredTransactions = Array.Empty<Transaction>();
    private IReadOnlyCollection<Category> categories = Array.Empty<Category>();
    private int selectedCategoryId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? false)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        categories = (await CategoryService.GetCategoriesAsync(userId)).ToArray();
        transactions = (await TransactionService.GetTransactionsAsync(userId)).ToArray();

        // Read optional category filter from query string (supports non-interactive fallback)
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("categoryId", out var catVal) && int.TryParse(catVal, out var catId))
        {
            selectedCategoryId = catId;
        }

        ApplyFilter();
    }

    private void AddTransaction()
    {
        Navigation.NavigateTo("/addedittransaction");
    }

    private void EditTransaction(int transactionId)
    {
        Navigation.NavigateTo($"/addedittransaction/{transactionId}");
    }

    private async Task DeleteTransaction(int transactionId)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        await TransactionService.DeleteTransactionAsync(transactionId, userId);
        transactions = (await TransactionService.GetTransactionsAsync(userId)).ToArray();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredTransactions = selectedCategoryId == 0
            ? transactions
            : transactions.Where(t => t.CategoryId == selectedCategoryId);
    }

    private int SelectedCategoryId
    {
        get => selectedCategoryId;
        set
        {
            if (selectedCategoryId == value) return;
            selectedCategoryId = value;
            ApplyFilter();
        }
    }
}
